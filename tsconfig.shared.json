{
	"compilerOptions": {
		"target": "es2022",
		"module": "nodenext",
		"strict": true,
		"verbatimModuleSyntax": true,
		"composite": true,
		"declarationMap": true,
		"removeComments": true,
		"skipLibCheck": true,
		"rootDir": "${configDir}/src",
		"outDir": "${configDir}/dist",
		"lib": ["dom", "esnext"],
	},
	"include": ["${configDir}/src"],
}
