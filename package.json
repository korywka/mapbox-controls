{
  "name": "mapbox-gl-controls",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "publish": "pnpm --recursive publish",
    "lint": "oxlint --deny-warnings packages && oxfmt --check 'packages/*/src/**/*.ts'",
    "format": "oxfmt 'packages/*/src/**/*.ts'"
  },
  "devDependencies": {
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1"
    }
  }
}
