{
	"name": "preview",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "pnpm copy-worker && esbuild preview.ts --bundle --format=esm --outfile=preview.bundle.js --main-fields=source,browser,module,main --servedir=. --serve=localhost:8000 --watch",
		"build": "pnpm copy-worker && esbuild preview.ts --bundle --format=esm --outfile=preview.bundle.js --main-fields=source,browser,module,main",
		"copy-worker": "cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs ."
	},
	"dependencies": {
		"@mapbox-controls/compass": "workspace:*",
		"@mapbox-controls/image": "workspace:*",
		"@mapbox-controls/inspect": "workspace:*",
		"@mapbox-controls/language": "workspace:*",
		"@mapbox-controls/ruler": "workspace:*",
		"@mapbox-controls/styles": "workspace:*",
		"@mapbox-controls/tooltip": "workspace:*",
		"@mapbox-controls/zoom": "workspace:*",
		"mapbox-gl": "catalog:",
		"maplibre-gl": "catalog:"
	},
	"devDependencies": {
		"@types/geojson": "catalog:",
		"esbuild": "0.28.2"
	}
}
